{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(~/.ssh/**)",

      "Bash(npm publish)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish)",
      "Bash(yarn publish:*)",
      "Bash(npx npm publish:*)"
    ],
    "ask": ["Bash(git push)", "Bash(git push:*)"]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 300,
            "command": "pnpm test"
          }
        ]
      }
    ]
  }
}
