{
  "name": "strikemath",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-free TypeScript library for options pricing, Greeks, implied volatility and risk metrics.",
  "keywords": [
    "options",
    "black-scholes",
    "greeks",
    "implied-volatility",
    "binomial",
    "quantitative-finance",
    "derivatives",
    "typescript"
  ],
  "license": "MIT",
  "author": "Rabi Alzare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rabi-ALZ/strikemath.git"
  },
  "homepage": "https://github.com/Rabi-ALZ/strikemath#readme",
  "bugs": {
    "url": "https://github.com/Rabi-ALZ/strikemath/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:bench": "vitest run test/hull.bench.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "examples": "tsx examples/01-pricing.ts && tsx examples/02-greeks.ts && tsx examples/03-implied-vol.ts && tsx examples/04-risk.ts",
    "examples:smoke": "pnpm build && node examples/smoke-dist.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
